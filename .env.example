PROJECT_NAME=Lectio
# development, production or test. With production the API refuses to start
# if a setting is unsafe (http/localhost FRONTEND_URL, weak SECRET_KEY, no
# email, ...) and says what to fix; see app/core/startup_checks.py.
APP_ENV=development
MONGODB_URI=
MONGO_DB=Fast
FRONTEND_URL=http://localhost:5173
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Optional - enables the "Sign in with Google" buttons)
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# the redirect URI below to its "Authorized redirect URIs".
# GOOGLE_REDIRECT_URI defaults to <this API>/api/v1/auth/google/callback,
# e.g. http://localhost:8000/api/v1/auth/google/callback in development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP Settings (Optional - for email functionality)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Alert webhook (Optional - receives a POST for every threshold-breach alert)
ALERT_WEBHOOK_URL=

# Alert emails (need the SMTP settings above). Sent to the device owner when a
# new WARNING or CRITICAL alert is raised, at most once per device and rule in the cooldown.
ALERT_EMAILS_ENABLED=true
ALERT_EMAIL_MIN_SEVERITY=WARNING
ALERT_EMAIL_COOLDOWN_MINUTES=30

# An open alert closes by itself once its reading hasn't been reported for
# this many minutes (for example a sensor that stopped answering).
ALERT_STALE_MINUTES=15

# Every raw reading is kept this many days, then deleted automatically.
# Graphs longer than a day use the hourly and daily summaries below.
TELEMETRY_RETENTION_DAYS=7
# Hourly and daily summaries of the readings, for longer graphs.
ROLLUP_HOURLY_RETENTION_DAYS=90
ROLLUP_DAILY_RETENTION_DAYS=730

# The Windows agent handed out at /api/v1/agent/download (the site's
# "Download for Windows" buttons). agent/build_exe.py copies each build here.
AGENT_DOWNLOAD_PATH=downloads/lectio-agent.exe

# AI diagnosis and fix advice with Google Gemini (Optional - without a key,
# both use Lectio's built-in rules). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_FIX_TIMEOUT_SECONDS=10

# Rate Limiting (requests per minute; over the limit the API answers 429)
# Counters are kept per process: with N workers the effective limit is N times higher.
# Behind a reverse proxy, start uvicorn with --proxy-headers so limits apply per visitor IP.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_INGEST_PER_MINUTE=120
RATE_LIMIT_FIX_PER_MINUTE=10
# --- Database connection pool (one per API process) and timeouts, in ms
MONGO_MAX_POOL_SIZE=50
MONGO_MIN_POOL_SIZE=2
MONGO_MAX_IDLE_TIME_MS=300000
MONGO_CONNECT_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=15000
MONGO_SOCKET_TIMEOUT_MS=120000
MONGO_WAIT_QUEUE_TIMEOUT_MS=10000
MONGO_STARTUP_RETRIES=10
# Database commands slower than this are logged as warnings
SLOW_QUERY_MS=500

# --- Shared state. Leave REDIS_URL empty to run ONE API process: cache, rate
# limits, alert state and live updates then live in its memory. Set it (e.g.
# redis://localhost:6379/0) to run several API processes or servers behind a
# load balancer; they share all of that through Redis. Needs the redis extra:
# uv sync --extra redis
REDIS_URL=
CACHE_USER_TTL_SECONDS=30
CACHE_DEVICE_TTL_SECONDS=60
CACHE_LATEST_READING_TTL_SECONDS=600

# --- Telemetry ingestion: readings per batch upload, and the background
# workers that run alert checks after readings are stored
INGEST_BATCH_MAX=100
INGEST_QUEUE_SIZE=10000
INGEST_WORKERS=2
