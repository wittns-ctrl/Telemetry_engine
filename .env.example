PROJECT_NAME=Lectio
APP_ENV=development
MONGODB_URI=
MONGO_DB=Fast
FRONTEND_URL=http://localhost:5173
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (Optional - enables the "Sign in with Google" buttons)
# Create an OAuth client (type: Web application) in Google Cloud Console and add
# the redirect URI below to its "Authorized redirect URIs".
# GOOGLE_REDIRECT_URI defaults to <this API>/api/v1/auth/google/callback,
# e.g. http://localhost:8000/api/v1/auth/google/callback in development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# SMTP Settings (Optional - for email functionality)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

# Alert webhook (Optional - receives a POST for every threshold-breach alert)
ALERT_WEBHOOK_URL=

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60