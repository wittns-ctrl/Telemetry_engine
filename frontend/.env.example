# Frontend build settings (Vite reads these at build time, not at run time).
# Copy to frontend/.env.production (or .env.local for development) and fill in.

# Where the Lectio API is. Defaults to http://localhost:8000.
# On Vercel, set it to the site's own address (e.g. https://getlectio.vercel.app):
# vercel.json passes /api/* on to the API, so the sign-in cookie belongs to
# the site itself and survives a reload. A cookie set by an API on another
# site is a third-party cookie, which browsers block.
VITE_API_BASE=https://your-site.vercel.app

# Where the live WebSocket streams are. Defaults to VITE_API_BASE with
# http(s) swapped for ws(s). Vercel can't pass WebSockets on, so behind its
# proxy set this to the API's own address (the sockets sign in with a ticket,
# not the cookie).
# VITE_WS_ORIGIN=wss://your-api.onrender.com

# Where the "Download for Windows" buttons point. Defaults to the API itself
# (VITE_API_BASE + /api/v1/agent/download), which serves downloads/lectio-agent.exe.
# Only set this to host the file somewhere else.
# VITE_AGENT_DOWNLOAD_URL=https://example.com/lectio-agent.exe
